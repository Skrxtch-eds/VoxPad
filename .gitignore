# Keep this repository limited to the application, documentation and tests.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/requirements-build.txt
!/run.bat
!/scripts/
!/tests/
!/docs/
!/.github/
!/outputs/

/outputs/*
!/outputs/source/
!/outputs/Launch.vbs

# Existing screenshot shows an older application version.
/docs/screenshots/

__pycache__/
*.py[cod]
.venv/
.env
.env.*
*.log
*.sqlite*
*.db
*.raw
*.onnx
*.zip
*.tar.*
*.tmp
*.update
.tmp-*/
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.pem
*.key
*.pfx
*.p12
settings.json
history.json
data/
models/
*.mp3
*.mp4
*.m4a
*.flac
*.ogg
*.webm
*.wav
!outputs/source/assets/record-start.wav
!outputs/source/assets/record-stop.wav
